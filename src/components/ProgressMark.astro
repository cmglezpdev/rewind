---
interface Props {
  kind: 'chapter' | 'video' | 'course';
  id: string;
  /** Show the percentage as a thin bar (videos and courses). */
  bar?: boolean;
  /** Show the state in words next to the glyph. Without it the words are screen-reader only. */
  text?: boolean;
  /** Course only: also show "N of M lessons done". Pass the number of lessons. */
  lessons?: number;
  class?: string;
}

const { kind, id, bar = false, text = false, lessons, class: className } = Astro.props;
const initial = kind === 'chapter' ? 'Not read' : 'Not started';
---

<span class:list={['progress-mark', className]} data-progress-ref={`${kind}:${id}`} data-state="pending" title={initial}>
  <span class="progress-line">
    <svg class="progress-glyph" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <circle class="pg-track" cx="10" cy="10" r="8" />
      <circle class="pg-arc" cx="10" cy="10" r="8" pathLength="100" />
      <path class="pg-check" d="M6.2 10.4l2.6 2.6 5-5.4" />
    </svg>
    <span class:list={[text ? 'progress-text' : 'sr-only']} data-progress-text>{initial}</span>
  </span>
  {lessons !== undefined && (
    <span class="progress-text" data-progress-text="lessons">0 of {lessons} lessons done</span>
  )}
  {bar && (
    <span class="progress-bar" aria-hidden="true"><span class="progress-bar-fill"></span></span>
  )}
</span>
