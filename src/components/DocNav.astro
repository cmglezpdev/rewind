---
import type { NoteDocument } from '../lib/library';

interface Props {
  previous?: NoteDocument;
  next?: NoteDocument;
}

const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav
    class="mt-12 grid gap-4 border-t border-ivory-deep pt-8 sm:grid-cols-2"
    aria-label="Document navigation"
  >
    {previous ? (
      <a
        href={previous.href}
        class="group rounded-xl border border-ivory-deep bg-white/40 p-4 no-underline transition hover:border-terracotta/40"
      >
        <span class="text-xs font-medium uppercase tracking-wide text-ink-faint">Previous chapter</span>
        <span class="mt-1 block font-serif text-lg text-ink group-hover:text-terracotta">
          {previous.title}
        </span>
      </a>
    ) : (
      <div />
    )}
    {next ? (
      <a
        href={next.href}
        class="group rounded-xl border border-ivory-deep bg-white/40 p-4 text-right no-underline transition hover:border-terracotta/40 sm:col-start-2"
      >
        <span class="text-xs font-medium uppercase tracking-wide text-ink-faint">Next chapter</span>
        <span class="mt-1 block font-serif text-lg text-ink group-hover:text-terracotta">
          {next.title}
        </span>
      </a>
    ) : (
      <div />
    )}
  </nav>
)}
