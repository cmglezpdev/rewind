---
import type { NoteDocument, Video } from '../lib/library';
import ProgressMark from './ProgressMark.astro';

interface Props {
  chapters?: NoteDocument[];
  currentId?: string;
  videoName?: string;
  courseName?: string;
  lessons?: Video[];
  currentVideoId?: string;
  courseId?: string;
  collapsible?: boolean;
}

const {
  chapters = [],
  currentId = '',
  videoName,
  courseName,
  lessons = [],
  currentVideoId,
  courseId,
  collapsible = false,
} = Astro.props;

const kindLabel: Record<NoteDocument['kind'], string> = {
  overview: 'Overview',
  topic: 'Chapter',
  transcript: 'Transcript',
  index: 'Index',
};

const heading = videoName ?? courseName ?? 'Contents';
const chapterNav = chapters.length > 0;
const lessonNav = lessons.length > 0;
const showVideoProgress = Boolean(videoName && currentVideoId) && chapters.some((doc) => doc.kind === 'topic');
const showCourseProgress = !videoName && Boolean(courseId) && lessonNav;
---

{
  collapsible ? (
    <details class="rounded-xl border border-ivory-deep bg-surface/40 p-4">
      <summary class="min-h-11 content-center cursor-pointer text-sm font-medium text-ink">
        {chapterNav ? 'Chapters in this video' : 'Course lessons'}
      </summary>
      <div class="mt-4 space-y-6">
        <div>
          <p class="font-serif text-lg leading-snug text-ink">{heading}</p>
          {showVideoProgress && currentVideoId && <ProgressMark kind="video" id={currentVideoId} text bar class="mt-3 w-full" />}
          {showCourseProgress && courseId && <ProgressMark kind="course" id={courseId} text bar lessons={lessons.length} class="mt-3 w-full" />}
        </div>
        {chapterNav && (
          <nav aria-label="Chapters">
            <ul class="space-y-1">
              {chapters.map((doc) => {
                const active = doc.id === currentId;
                return (
                  <li>
                    <a
                      href={doc.href}
                      class:list={[
                        'flex min-h-11 items-start gap-2 rounded-md px-2 py-1.5 text-sm no-underline transition',
                        active
                          ? 'bg-terracotta-soft font-medium text-terracotta-deep'
                          : 'text-ink-muted hover:bg-ivory-deep/60 hover:text-ink',
                      ]}
                      aria-current={active ? 'page' : undefined}
                    >
                      <span class="mt-0.5 flex w-[1.1rem] flex-none">
                        {doc.kind === 'topic' && <ProgressMark kind="chapter" id={doc.id} />}
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.65rem] uppercase tracking-wide text-ink-faint">{kindLabel[doc.kind]}</span>
                        <span class="mt-0.5 block leading-snug">{doc.title}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        )}
        {lessonNav && (
          <nav aria-label="Course lessons">
            <ul class="space-y-1">
              {lessons.map((lesson) => {
                const active = lesson.id === currentVideoId;
                return (
                  <li>
                    <a
                      href={lesson.overview.href}
                      class:list={[
                        'flex min-h-11 items-start gap-2 rounded-md px-2 py-1.5 text-sm no-underline transition',
                        active
                          ? 'bg-terracotta-soft font-medium text-terracotta-deep'
                          : 'text-ink-muted hover:bg-ivory-deep/60 hover:text-ink',
                      ]}
                      aria-current={active ? 'page' : undefined}
                    >
                      <span class="mt-0.5 flex w-[1.1rem] flex-none"><ProgressMark kind="video" id={lesson.id} /></span>
                      <span class="min-w-0 leading-snug">{lesson.name}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        )}
      </div>
    </details>
  ) : (
    <aside class="space-y-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-faint">
          {videoName ? 'In this video' : 'In this course'}
        </p>
        <p class="mt-1 font-serif text-lg leading-snug text-ink">{heading}</p>
        {showVideoProgress && currentVideoId && <ProgressMark kind="video" id={currentVideoId} text bar class="mt-3 w-full" />}
        {showCourseProgress && courseId && <ProgressMark kind="course" id={courseId} text bar lessons={lessons.length} class="mt-3 w-full" />}
      </div>
      {chapterNav && (
        <nav aria-label="Chapters">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-faint">Chapters</p>
          <ul class="space-y-1">
            {chapters.map((doc) => {
              const active = doc.id === currentId;
              return (
                <li>
                  <a
                    href={doc.href}
                    class:list={[
                      'flex min-h-11 items-start gap-2 rounded-md px-2 py-1.5 text-sm no-underline transition',
                      active
                        ? 'bg-terracotta-soft font-medium text-terracotta-deep'
                        : 'text-ink-muted hover:bg-ivory-deep/60 hover:text-ink',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    <span class="mt-0.5 flex w-[1.1rem] flex-none">
                      {doc.kind === 'topic' && <ProgressMark kind="chapter" id={doc.id} />}
                    </span>
                    <span class="min-w-0">
                      <span class="block text-[0.65rem] uppercase tracking-wide text-ink-faint">{kindLabel[doc.kind]}</span>
                      <span class="mt-0.5 block leading-snug">{doc.title}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )}
      {lessonNav && (
        <nav aria-label="Course lessons">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-faint">Lessons</p>
          <ul class="space-y-1">
            {lessons.map((lesson) => {
              const active = lesson.id === currentVideoId;
              return (
                <li>
                  <a
                    href={lesson.overview.href}
                    class:list={[
                      'flex min-h-11 items-start gap-2 rounded-md px-2 py-1.5 text-sm no-underline transition',
                      active
                        ? 'bg-terracotta-soft font-medium text-terracotta-deep'
                        : 'text-ink-muted hover:bg-ivory-deep/60 hover:text-ink',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    <span class="mt-0.5 flex w-[1.1rem] flex-none"><ProgressMark kind="video" id={lesson.id} /></span>
                    <span class="min-w-0 leading-snug">{lesson.name}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )}
    </aside>
  )
}
