---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'Structured notes from video talks and courses.', lang = 'en' } = Astro.props;
const fullTitle = title === 'Library' ? 'Video Notes' : `${title} · Video Notes`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body class="site-shell">
    <a href="#content" class="skip-link">Skip to content</a>
    <slot name="header" />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-ivory-deep bg-ivory-deep/30 py-8 text-center text-sm text-ink-faint">
      <p>Notes rendered from local Markdown. Originals are on YouTube.</p>
    </footer>
  </body>
</html>
