---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import ProgressRuntime from '../components/ProgressRuntime.astro';
import themeScript from '../scripts/theme.js?raw';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'Structured notes from video talks and courses.', lang = 'en' } = Astro.props;
const fullTitle = title === 'Library' ? 'Rewind · Keep what you learn.' : `${title} · Rewind`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="Rewind" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <Analytics />
  </head>
  <body class="site-shell">
    <a href="#content" class="skip-link">Skip to content</a>
    <slot name="header" />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-ivory-deep bg-ivory-deep/30 py-8 text-center text-sm text-ink-faint">
      <p>Notes rendered from local Markdown. Originals are on YouTube.</p>
    </footer>
    <ProgressRuntime />
  </body>
</html>
