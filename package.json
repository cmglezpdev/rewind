{
  "name": "rewind",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "predev": "node scripts/sync-media.mjs",
    "prebuild": "npm run validate:library && node scripts/sync-media.mjs",
    "check": "astro check",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "import:notes": "node scripts/import-notes.mjs",
    "validate:library": "node --import tsx scripts/validate-library.ts",
    "tags": "node --import tsx scripts/tags.ts",
    "migrate:frontmatter": "node --import tsx scripts/migrate-frontmatter.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.5",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
